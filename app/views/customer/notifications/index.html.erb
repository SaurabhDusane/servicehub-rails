<div class="flex items-center justify-between mb-6">
  <h1 class="text-2xl font-bold">Notifications</h1>
  <%= button_to "Mark all read", read_all_customer_notifications_path, method: :patch, class: "btn-secondary" %>
</div>
<% if @notifications.any? %>
  <ul class="space-y-2">
    <% @notifications.each do |n| %>
      <li class="card <%= 'border-l-4 border-l-indigo-500' unless n.read? %>">
        <div class="flex items-start justify-between gap-4">
          <div>
            <div class="font-medium"><%= n.title %></div>
            <div class="text-sm text-gray-600"><%= n.body %></div>
            <div class="text-xs text-gray-400 mt-1"><%= time_ago_in_words(n.created_at) %> ago</div>
          </div>
          <% unless n.read? %>
            <%= button_to "Mark read", read_customer_notification_path(n), method: :patch, class: "btn-ghost text-sm" %>
          <% end %>
        </div>
      </li>
    <% end %>
  </ul>
  <div class="mt-6"><%= paginate @notifications %></div>
<% else %>
  <div class="card text-center text-gray-500">You have no notifications.</div>
<% end %>
