<h1 class="text-2xl font-bold mb-6">Confirm booking</h1>
<div class="card max-w-xl">
  <div class="mb-4">
    <div class="font-semibold text-lg"><%= @service.name %></div>
    <div class="text-gray-500"><%= @provider.business_name %></div>
    <div class="mt-3"><%= @start_time.in_time_zone(current_user.tz).strftime("%A, %b %d · %l:%M %p") %> (<%= @service.duration_minutes %> min)</div>
  </div>

  <%= form_with model: @booking, url: customer_bookings_path, local: true, class: "space-y-4" do |f| %>
    <%= hidden_field_tag :service_id, @service.id %>
    <%= f.hidden_field :start_time, value: @start_time.iso8601 %>
    <div>
      <label class="label">Notes for the provider (optional)</label>
      <%= f.text_area :notes, rows: 3, class: "input" %>
    </div>
    <div class="flex items-center justify-between border-t border-gray-100 pt-4">
      <div>
        <div class="text-sm text-gray-500">Total</div>
        <div class="text-xl font-bold"><%= Money.new(@service.price_cents, @service.currency).format %></div>
        <% if @service.requires_deposit? %>
          <div class="text-xs text-gray-500">Deposit now: <%= Money.new(@service.deposit_cents, @service.currency).format %></div>
        <% end %>
      </div>
      <%= f.submit "Reserve & continue to payment", class: "btn-primary" %>
    </div>
  <% end %>
</div>
