<h1 class="text-2xl font-bold mb-2">Set up your provider profile</h1>
<p class="text-gray-600 mb-6">Tell customers about your business. You can edit this anytime.</p>

<%= form_with model: @profile, url: provider_onboarding_path, method: :patch, local: true, html: { multipart: true }, class: "card space-y-4 max-w-2xl" do |f| %>
  <% if @profile.errors.any? %>
    <div class="flash-alert"><%= @profile.errors.full_messages.to_sentence %></div>
  <% end %>
  <div>
    <label class="label">Business name</label>
    <%= f.text_field :business_name, class: "input" %>
  </div>
  <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
    <div>
      <label class="label">Category</label>
      <%= f.select :category, ProviderProfile::CATEGORIES.map { |c| [c.humanize, c] }, { prompt: "Choose…" }, class: "input" %>
    </div>
    <div>
      <label class="label">Service area / city</label>
      <%= f.text_field :location, class: "input", placeholder: "Austin, TX" %>
    </div>
    <div>
      <label class="label">Service radius (km)</label>
      <%= f.number_field :service_radius_km, class: "input", value: (@profile.service_radius_km || 25) %>
    </div>
    <div>
      <label class="label">Typical response time</label>
      <%= f.select :response_time, ProviderProfile::RESPONSE_TIMES.map { |r| [r.humanize, r] }, {}, class: "input" %>
    </div>
  </div>
  <div>
    <label class="label">Bio</label>
    <%= f.text_area :bio, rows: 4, class: "input", placeholder: "Introduce yourself to customers…" %>
  </div>
  <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
    <div>
      <label class="label">Cancellation cutoff (hours)</label>
      <%= f.number_field :cancellation_cutoff_hours, class: "input", value: (@profile.cancellation_cutoff_hours || 24) %>
    </div>
    <div>
      <label class="label">Cancellation policy</label>
      <%= f.text_field :cancellation_policy, class: "input" %>
    </div>
  </div>
  <div>
    <label class="label">Cover image</label>
    <%= f.file_field :cover_image, accept: "image/*", class: "input" %>
  </div>
  <div class="flex justify-end">
    <%= f.submit "Save & continue", class: "btn-primary" %>
  </div>
<% end %>
