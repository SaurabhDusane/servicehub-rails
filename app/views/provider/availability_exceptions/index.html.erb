<h1 class="text-2xl font-bold mb-6">Time off & exceptions</h1>

<div class="grid grid-cols-1 lg:grid-cols-[1fr_22rem] gap-6">
  <div class="card">
    <% if @exceptions.any? %>
      <ul class="divide-y divide-gray-100">
        <% @exceptions.each do |ex| %>
          <li class="py-3 flex items-center justify-between">
            <div>
              <div class="font-medium"><%= ex.date.to_fs(:long) %></div>
              <div class="text-sm text-gray-500">
                <%= ex.exception_type.humanize %><%= ex.custom_hours? ? " · #{ex.start_time.strftime('%l:%M %p')} – #{ex.end_time.strftime('%l:%M %p')}" : "" %>
                <%= " · #{ex.reason}" if ex.reason.present? %>
              </div>
            </div>
            <%= button_to "Remove", provider_availability_exception_path(ex), method: :delete, class: "btn-ghost text-sm text-red-600", data: { turbo_confirm: "Remove?" } %>
          </li>
        <% end %>
      </ul>
    <% else %>
      <p class="text-gray-500 text-sm">No exceptions configured.</p>
    <% end %>
  </div>

  <div class="card">
    <h2 class="font-semibold mb-4">Add exception</h2>
    <%= form_with model: @exception, url: provider_availability_exceptions_path, local: true, class: "space-y-3" do |f| %>
      <div><label class="label">Date</label><%= f.date_field :date, class: "input" %></div>
      <div>
        <label class="label">Type</label>
        <%= f.select :exception_type, AvailabilityException.exception_types.keys.map { |k| [k.humanize, k] }, {}, class: "input" %>
      </div>
      <div class="grid grid-cols-2 gap-2">
        <div><label class="label">Start (custom)</label><%= f.time_field :start_time, class: "input" %></div>
        <div><label class="label">End (custom)</label><%= f.time_field :end_time, class: "input" %></div>
      </div>
      <div><label class="label">Reason (optional)</label><%= f.text_field :reason, class: "input" %></div>
      <%= f.submit "Add", class: "btn-primary w-full" %>
    <% end %>
  </div>
</div>
