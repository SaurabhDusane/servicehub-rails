<h1 class="text-2xl font-bold mb-6">New exception</h1>
<%= form_with model: @exception, url: provider_availability_exceptions_path, local: true, class: "card space-y-3 max-w-sm" do |f| %>
  <div><label class="label">Date</label><%= f.date_field :date, class: "input" %></div>
  <div>
    <label class="label">Type</label>
    <%= f.select :exception_type, AvailabilityException.exception_types.keys.map { |k| [k.humanize, k] }, {}, class: "input" %>
  </div>
  <%= f.submit "Create", class: "btn-primary" %>
<% end %>
