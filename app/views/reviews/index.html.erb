<section class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8 py-10">
  <h1 class="text-2xl font-bold mb-6">Reviews for <%= @provider.business_name %></h1>
  <% if @reviews.any? %>
    <ul class="space-y-4">
      <% @reviews.each do |r| %>
        <li class="card">
          <div class="flex items-center gap-2">
            <%= render "shared/star_rating", rating: r.rating %>
            <span class="font-medium"><%= r.customer.full_name %></span>
            <span class="text-gray-400 text-sm">· <%= r.created_at.to_date.to_fs(:long) %></span>
          </div>
          <p class="mt-2 text-gray-700"><%= r.body %></p>
        </li>
      <% end %>
    </ul>
    <div class="mt-6"><%= paginate @reviews %></div>
  <% else %>
    <div class="card text-center text-gray-500">No reviews yet.</div>
  <% end %>
</section>
