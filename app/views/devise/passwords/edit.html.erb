<section class="mx-auto max-w-md px-4 py-16">
  <div class="card">
    <h1 class="text-2xl font-bold mb-6">Set new password</h1>
    <%= form_with model: resource, url: password_path(resource_name), method: :put, local: true, class: "space-y-4" do |f| %>
      <%= f.hidden_field :reset_password_token %>
      <div><%= f.label :password, class: "label" %><%= f.password_field :password, class: "input", required: true %></div>
      <div><%= f.label :password_confirmation, class: "label" %><%= f.password_field :password_confirmation, class: "input", required: true %></div>
      <%= f.submit "Change password", class: "btn-primary w-full" %>
    <% end %>
  </div>
</section>
