<section class="mx-auto max-w-md px-4 py-16">
  <div class="card">
    <h1 class="text-2xl font-bold mb-6">Forgot your password?</h1>
    <%= form_with model: resource, url: password_path(resource_name), local: true, class: "space-y-4" do |f| %>
      <div><%= f.label :email, class: "label" %><%= f.email_field :email, class: "input", autofocus: true, required: true %></div>
      <%= f.submit "Send reset instructions", class: "btn-primary w-full" %>
    <% end %>
  </div>
</section>
