<section class="mx-auto max-w-md px-4 py-16">
  <div class="card">
    <h1 class="text-2xl font-bold mb-6">Create your account</h1>
    <%= form_with model: resource, url: registration_path(resource_name), local: true, class: "space-y-4" do |f| %>
      <% if resource.errors.any? %>
        <div class="flash-alert"><%= resource.errors.full_messages.to_sentence %></div>
      <% end %>
      <div class="grid grid-cols-2 gap-3">
        <div><%= f.label :first_name, class: "label" %><%= f.text_field :first_name, class: "input", required: true %></div>
        <div><%= f.label :last_name, class: "label" %><%= f.text_field :last_name, class: "input", required: true %></div>
      </div>
      <div><%= f.label :email, class: "label" %><%= f.email_field :email, class: "input", required: true, autocomplete: "email" %></div>
      <div><%= f.label :password, class: "label" %><%= f.password_field :password, class: "input", autocomplete: "new-password", required: true %></div>
      <div><%= f.label :password_confirmation, class: "label" %><%= f.password_field :password_confirmation, class: "input", autocomplete: "new-password", required: true %></div>
      <div>
        <%= f.label :role, "I am a…", class: "label" %>
        <%= f.select :role, [["Customer", "customer"], ["Service Provider", "provider"]], { selected: "customer" }, class: "input" %>
      </div>
      <div>
        <%= f.label :timezone, class: "label" %>
        <%= f.time_zone_select :timezone, nil, { default: "UTC" }, class: "input" %>
      </div>
      <%= f.submit "Create account", class: "btn-primary w-full" %>
    <% end %>
    <p class="mt-4 text-sm text-gray-500">Already a member? <%= link_to "Log in", new_session_path(resource_name), class: "underline" %></p>
  </div>
</section>
