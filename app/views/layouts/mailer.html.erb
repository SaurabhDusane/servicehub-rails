<!DOCTYPE html>
<html>
  <head>
    <meta charset="utf-8">
    <style>
      body { font-family: -apple-system, Segoe UI, sans-serif; background: #f9fafb; margin: 0; padding: 24px; color: #111827; }
      .container { max-width: 560px; margin: 0 auto; background: white; border-radius: 12px; padding: 32px; }
      .brand { font-weight: 700; color: #4f46e5; font-size: 20px; margin-bottom: 16px; }
      .button { display: inline-block; background: #4f46e5; color: white; text-decoration: none; padding: 10px 16px; border-radius: 8px; font-weight: 600; margin-top: 16px; }
      .meta { color: #6b7280; font-size: 12px; margin-top: 24px; }
    </style>
  </head>
  <body>
    <div class="container">
      <div class="brand">ServiceHub</div>
      <%= yield %>
      <div class="meta">You received this email from ServiceHub. If this wasn't you, please ignore it.</div>
    </div>
  </body>
</html>
