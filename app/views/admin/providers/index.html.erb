<h1 class="text-2xl font-bold mb-6">Providers</h1>
<div class="card p-0 overflow-hidden">
  <table class="min-w-full text-sm divide-y divide-gray-200">
    <thead class="bg-gray-50 text-xs uppercase text-gray-500 text-left">
      <tr><th class="px-4 py-3">Business</th><th class="px-4 py-3">Category</th><th class="px-4 py-3">Status</th><th class="px-4 py-3">Rating</th><th></th></tr>
    </thead>
    <tbody class="divide-y divide-gray-100">
      <% @providers.each do |p| %>
        <tr>
          <td class="px-4 py-3"><%= p.business_name %></td>
          <td class="px-4 py-3"><%= p.category.humanize %></td>
          <td class="px-4 py-3"><span class="badge-gray"><%= p.status.humanize %></span></td>
          <td class="px-4 py-3"><%= number_with_precision(p.average_rating, precision: 1) %> (<%= p.total_reviews %>)</td>
          <td class="px-4 py-3 text-right"><%= link_to "View", admin_provider_path(p), class: "text-indigo-600 hover:underline" %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>
<div class="mt-6"><%= paginate @providers %></div>
