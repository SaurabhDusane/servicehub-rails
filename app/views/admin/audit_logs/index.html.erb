<h1 class="text-2xl font-bold mb-6">Audit log</h1>
<div class="card p-0 overflow-hidden">
  <table class="min-w-full text-sm divide-y divide-gray-200">
    <thead class="bg-gray-50 text-xs uppercase text-gray-500 text-left">
      <tr><th class="px-4 py-3">When</th><th class="px-4 py-3">Action</th><th class="px-4 py-3">User</th><th class="px-4 py-3">Target</th></tr>
    </thead>
    <tbody class="divide-y divide-gray-100 font-mono text-xs">
      <% @logs.each do |log| %>
        <tr>
          <td class="px-4 py-3 whitespace-nowrap"><%= log.created_at.strftime("%Y-%m-%d %H:%M") %></td>
          <td class="px-4 py-3"><%= log.action %></td>
          <td class="px-4 py-3"><%= log.user&.email || "system" %></td>
          <td class="px-4 py-3"><%= "#{log.target_type}##{log.target_id}" if log.target_type %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>
<div class="mt-6"><%= paginate @logs %></div>
