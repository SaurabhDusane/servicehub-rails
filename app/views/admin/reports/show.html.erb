<h1 class="text-2xl font-bold mb-6">Report #<%= @report.id %></h1>
<div class="card max-w-xl space-y-3">
  <div><strong>Target:</strong> <%= @report.target_type %> #<%= @report.target_id %></div>
  <div><strong>Reason:</strong> <%= @report.reason.humanize %></div>
  <div><strong>Reporter:</strong> <%= @report.reporter.email %></div>
  <div><strong>Notes:</strong><p class="text-gray-700"><%= @report.notes %></p></div>
  <div><strong>Status:</strong> <%= @report.status.humanize %></div>

  <%= form_with url: admin_report_path(@report), method: :patch, local: true, class: "space-y-3 border-t pt-4" do |f| %>
    <div>
      <label class="label">Set status</label>
      <%= f.select :status, Report.statuses.keys.map { |s| [s.humanize, s] }, {}, class: "input" %>
    </div>
    <div>
      <label class="label">Resolution notes</label>
      <%= f.text_area :resolution_notes, rows: 3, class: "input" %>
    </div>
    <%= f.submit "Update", class: "btn-primary" %>
  <% end %>
</div>
