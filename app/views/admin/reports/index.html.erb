<h1 class="text-2xl font-bold mb-6">Reports</h1>
<div class="card p-0 overflow-hidden">
  <table class="min-w-full text-sm divide-y divide-gray-200">
    <thead class="bg-gray-50 text-xs uppercase text-gray-500 text-left">
      <tr><th class="px-4 py-3">Target</th><th class="px-4 py-3">Reason</th><th class="px-4 py-3">Reporter</th><th class="px-4 py-3">Status</th><th class="px-4 py-3">Filed</th><th></th></tr>
    </thead>
    <tbody class="divide-y divide-gray-100">
      <% @reports.each do |r| %>
        <tr>
          <td class="px-4 py-3"><%= r.target_type %> #<%= r.target_id %></td>
          <td class="px-4 py-3"><%= r.reason.humanize %></td>
          <td class="px-4 py-3"><%= r.reporter.email %></td>
          <td class="px-4 py-3"><span class="badge-gray"><%= r.status.humanize %></span></td>
          <td class="px-4 py-3"><%= r.created_at.to_date %></td>
          <td class="px-4 py-3 text-right"><%= link_to "Review", admin_report_path(r), class: "text-indigo-600 hover:underline" %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>
<div class="mt-6"><%= paginate @reports %></div>
