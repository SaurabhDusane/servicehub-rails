<h1 class="text-2xl font-bold mb-6">Admin overview</h1>

<div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-6 gap-3 mb-8">
  <div class="card"><div class="text-xs text-gray-500">Users</div><div class="text-2xl font-bold"><%= @total_users %></div></div>
  <div class="card"><div class="text-xs text-gray-500">Providers</div><div class="text-2xl font-bold"><%= @total_providers %></div></div>
  <div class="card"><div class="text-xs text-gray-500">Bookings</div><div class="text-2xl font-bold"><%= @total_bookings %></div></div>
  <div class="card"><div class="text-xs text-gray-500">Revenue</div><div class="text-2xl font-bold"><%= Money.new(@gross_revenue_cents).format %></div></div>
  <div class="card"><div class="text-xs text-gray-500">Open reports</div><div class="text-2xl font-bold text-amber-600"><%= @pending_reports %></div></div>
  <div class="card"><div class="text-xs text-gray-500">Flagged reviews</div><div class="text-2xl font-bold text-red-600"><%= @flagged_reviews %></div></div>
</div>

<div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
  <section class="card">
    <h2 class="font-semibold mb-4">Top categories</h2>
    <ul class="space-y-2 text-sm">
      <% @top_categories.first(8).each do |cat, count| %>
        <li class="flex justify-between"><span><%= cat.humanize %></span><span class="text-gray-500"><%= count %></span></li>
      <% end %>
    </ul>
  </section>

  <section class="card">
    <h2 class="font-semibold mb-4">Recent activity</h2>
    <ul class="text-sm divide-y divide-gray-100">
      <% @recent_activity.each do |log| %>
        <li class="py-2 flex items-center justify-between">
          <div>
            <span class="font-mono text-xs text-gray-500"><%= log.action %></span>
            <% if log.user %>by <%= log.user.email %><% end %>
          </div>
          <div class="text-xs text-gray-400"><%= time_ago_in_words(log.created_at) %> ago</div>
        </li>
      <% end %>
    </ul>
  </section>
</div>
