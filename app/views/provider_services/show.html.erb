<% content_for :title, @service.name %>

<section class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-10 grid grid-cols-1 lg:grid-cols-3 gap-8">
  <div class="lg:col-span-2 space-y-6">
    <nav class="text-sm text-gray-500">
      <%= link_to @provider.business_name, provider_path(@provider), class: "hover:underline" %> /
      <span class="text-gray-700"><%= @service.name %></span>
    </nav>
    <div class="card">
      <h1 class="text-2xl font-bold text-gray-900"><%= @service.name %></h1>
      <div class="mt-2 flex flex-wrap items-center gap-2 text-sm text-gray-600">
        <span class="badge-indigo"><%= @service.category.humanize %></span>
        <span>⏱ <%= @service.duration_minutes %> min</span>
        <span>· <%= @service.price.format %></span>
        <% if @service.requires_deposit? %>
          <span>· Deposit <%= @service.deposit.format %></span>
        <% end %>
      </div>
      <p class="mt-4 text-gray-700 whitespace-pre-line"><%= @service.description %></p>
    </div>
  </div>

  <aside>
    <div class="card sticky top-24">
      <h2 class="text-lg font-semibold mb-2">Pick a date & time</h2>
      <%= form_with url: provider_service_path(@provider, @service), method: :get, local: true do |f| %>
        <%= f.date_field :date, value: @date, min: Date.current, class: "input" %>
        <%= f.submit "Check availability", class: "btn-secondary w-full mt-3" %>
      <% end %>

      <div class="mt-6">
        <h3 class="text-sm font-semibold text-gray-700 mb-2">Available slots on <%= @date.to_fs(:long) %></h3>
        <% if @slots.any? %>
          <% if user_signed_in? && current_user.customer? %>
            <div class="grid grid-cols-2 gap-2">
              <% @slots.each do |slot| %>
                <%= button_to slot.start_time.strftime("%l:%M %p"),
                              customer_bookings_path,
                              method: :post,
                              params: { service_id: @service.id, booking: { start_time: slot.start_time.iso8601 } },
                              class: "btn-secondary text-sm py-2" %>
              <% end %>
            </div>
          <% else %>
            <div class="grid grid-cols-2 gap-2">
              <% @slots.each do |slot| %>
                <span class="btn-secondary text-sm py-2 opacity-70"><%= slot.start_time.strftime("%l:%M %p") %></span>
              <% end %>
            </div>
            <p class="text-xs text-gray-500 mt-3"><%= link_to "Log in", new_user_session_path, class: "underline" %> or <%= link_to "sign up", new_user_registration_path, class: "underline" %> to book.</p>
          <% end %>
        <% else %>
          <p class="text-sm text-gray-500">No slots available on this day. Try another date.</p>
        <% end %>
      </div>
    </div>
  </aside>
</section>
